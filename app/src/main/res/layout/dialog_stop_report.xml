<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/header_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan Report"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Total points"
            android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/tvTotal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="@color/text_primary"
            android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Steps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Steps taken"
            android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/tvSteps"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="@color/text_primary"
            android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:background="#30363D" android:layout_marginBottom="16dp"/>

    <!-- Green -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <View android:layout_width="12dp" android:layout_height="12dp"
            android:background="@drawable/legend_dot_green" android:layout_marginEnd="8dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Good ( &gt; -60 dBm )"
            android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/tvGreen"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0 (0%)" android:textColor="#00E664"
            android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Yellow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <View android:layout_width="12dp" android:layout_height="12dp"
            android:background="@drawable/legend_dot_yellow" android:layout_marginEnd="8dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Fair ( -60 to -70 dBm )"
            android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/tvYellow"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0 (0%)" android:textColor="#FFB400"
            android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Red -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <View android:layout_width="12dp" android:layout_height="12dp"
            android:background="@drawable/legend_dot_red" android:layout_marginEnd="8dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Weak ( &lt; -70 dBm )"
            android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/tvRed"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0 (0%)" android:textColor="#FF5252"
            android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Alert box -->
    <LinearLayout
        android:id="@+id/alertBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#330000"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textColor="#FF5252"
            android:textSize="18sp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvAlert"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WiFi coverage issue detected — consider adding an extender."
            android:textColor="#FF5252"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Close"
        android:backgroundTint="#30363D"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

</LinearLayout>
