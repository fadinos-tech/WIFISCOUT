<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/header_bg"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="10dp" android:paddingBottom="8dp"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="WiFi Scout" android:textColor="@color/text_primary"
                        android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvVersion" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Click Solutions"
                        android:textColor="@color/text_secondary" android:textSize="10sp" />
                </LinearLayout>
                <ProgressBar android:id="@+id/scanSpinner"
                    android:layout_width="24dp" android:layout_height="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#58A6FF"
                    android:visibility="gone" />
            </LinearLayout>

            <Button android:id="@+id/btnStartStop" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="START"
                android:textSize="18sp" android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/start_green" android:layout_marginBottom="8dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView android:id="@+id/tvSsid" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Network: --" android:textColor="@color/text_primary"
                    android:textSize="11sp" android:background="@drawable/info_card_bg"
                    android:padding="6dp" android:layout_marginEnd="4dp" android:gravity="center" />
                <TextView android:id="@+id/tvSignalStrength" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="-- dBm" android:textColor="@color/text_primary"
                    android:textSize="11sp" android:background="@drawable/info_card_bg"
                    android:padding="6dp" android:layout_marginEnd="4dp" android:gravity="center" />
                <TextView android:id="@+id/tvSignalQuality" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Quality: --" android:textColor="@color/text_primary"
                    android:textSize="11sp" android:background="@drawable/info_card_bg"
                    android:padding="6dp" android:gravity="center" />
            </LinearLayout>

            <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text=""
                android:textColor="#FFA726" android:textSize="12sp"
                android:gravity="center" android:layout_marginBottom="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <com.clicksolutions.wifiscout.WifiHeatmapView
            android:id="@+id/heatmapView"
            android:layout_width="0dp" android:layout_height="0dp"
            android:background="@color/heatmap_bg"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toTopOf="@id/footer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout android:id="@+id/footer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/header_bg"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="8dp" android:paddingBottom="16dp"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:id="@+id/tvPointCount" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Points: 0  Steps: 0"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="10dp" android:layout_height="10dp"
                        android:background="@drawable/legend_dot_red" android:layout_marginEnd="3dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Weak" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginEnd="8dp"/>
                    <View android:layout_width="10dp" android:layout_height="10dp"
                        android:background="@drawable/legend_dot_yellow" android:layout_marginEnd="3dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Fair" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginEnd="8dp"/>
                    <View android:layout_width="10dp" android:layout_height="10dp"
                        android:background="@drawable/legend_dot_green" android:layout_marginEnd="3dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Good" android:textColor="@color/text_secondary" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 1: Clear | Save | Share | Export CSV -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
                android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnClear" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:text="Clear" android:textSize="12sp"
                    android:backgroundTint="@color/clear_btn"
                    android:textColor="@android:color/white" android:layout_marginEnd="5dp" />
                <Button android:id="@+id/btnSave" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:text="Save" android:textSize="12sp"
                    android:backgroundTint="#1565C0"
                    android:textColor="@android:color/white" android:layout_marginEnd="5dp"
                    android:visibility="gone" />
                <Button android:id="@+id/btnShare" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:text="Share" android:textSize="12sp"
                    android:backgroundTint="#6A1B9A"
                    android:textColor="@android:color/white" android:layout_marginEnd="5dp" />
                <Button android:id="@+id/btnExportCsv" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:text="CSV" android:textSize="12sp"
                    android:backgroundTint="#1B5E20"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <!-- Row 2: Menu | Mark | (future) | (future) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btnMenu" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:text="Menu" android:textSize="12sp"
                    android:backgroundTint="#30363D"
                    android:textColor="@color/text_primary" android:layout_marginEnd="5dp" />
                <Button android:id="@+id/btnMark" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:text="+ Mark" android:textSize="12sp"
                    android:backgroundTint="#1E252E"
                    android:textColor="@android:color/white"
                    android:enabled="false" android:layout_marginEnd="5dp" />
                <Button android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:text=""
                    android:backgroundTint="#1A1F26"
                    android:enabled="false" android:layout_marginEnd="5dp" />
                <Button android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:text=""
                    android:backgroundTint="#1A1F26"
                    android:enabled="false" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LEFT DRAWER -->
    <LinearLayout android:id="@+id/drawer"
        android:layout_width="290dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:orientation="vertical"
        android:background="@color/header_bg" android:paddingTop="48dp"
        android:elevation="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp"
            android:paddingEnd="20dp" android:paddingBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WiFi Scout" android:textColor="@color/text_primary"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvDrawerVersion" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Click Solutions"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#30363D" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MAP MODE" android:textColor="@color/text_secondary"
            android:textSize="11sp" android:paddingStart="20dp"
            android:paddingTop="16dp" android:paddingBottom="8dp" />

        <RadioGroup android:id="@+id/rgMapMode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="12dp">
            <RadioButton android:id="@+id/rbAutoFit" android:layout_width="match_parent"
                android:layout_height="40dp" android:text="Auto-fit (always see all)"
                android:textColor="@color/text_primary" android:textSize="13sp"
                android:checked="true" android:buttonTint="#58A6FF" />
            <RadioButton android:id="@+id/rbAutoCenter" android:layout_width="match_parent"
                android:layout_height="40dp" android:text="Auto-center on position"
                android:textColor="@color/text_primary" android:textSize="13sp"
                android:buttonTint="#58A6FF" />
            <RadioButton android:id="@+id/rbFreeScroll" android:layout_width="match_parent"
                android:layout_height="40dp" android:text="Free scroll + mini-map"
                android:textColor="@color/text_primary" android:textSize="13sp"
                android:buttonTint="#58A6FF" />
        </RadioGroup>

        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#30363D" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ROAMING MARKER" android:textColor="@color/text_secondary"
            android:textSize="11sp" android:paddingStart="20dp"
            android:paddingTop="16dp" android:paddingBottom="8dp" />

        <RadioGroup android:id="@+id/rgRoamStyle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="12dp">
            <RadioButton android:id="@+id/rbFlashRing" android:layout_width="match_parent"
                android:layout_height="40dp" android:text="Flash ring"
                android:textColor="@color/text_primary" android:textSize="13sp"
                android:checked="true" android:buttonTint="#58A6FF" />
            <RadioButton android:id="@+id/rbLightning" android:layout_width="match_parent"
                android:layout_height="40dp" android:text="Lightning bolt"
                android:textColor="@color/text_primary" android:textSize="13sp"
                android:buttonTint="#58A6FF" />
            <RadioButton android:id="@+id/rbBanner" android:layout_width="match_parent"
                android:layout_height="40dp" android:text="Roaming banner"
                android:textColor="@color/text_primary" android:textSize="13sp"
                android:buttonTint="#58A6FF" />
            <RadioButton android:id="@+id/rbColorSplit" android:layout_width="match_parent"
                android:layout_height="40dp" android:text="Color split (blue after roam)"
                android:textColor="@color/text_primary" android:textSize="13sp"
                android:buttonTint="#58A6FF" />
        </RadioGroup>

        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#30363D" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SETTINGS" android:textColor="@color/text_secondary"
            android:textSize="11sp" android:paddingStart="20dp"
            android:paddingTop="16dp" android:paddingBottom="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp"
            android:paddingEnd="20dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Red signal alert"
                    android:textColor="@color/text_primary" android:textSize="13sp" />
                <TextView android:id="@+id/tvThresholdValue" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="20%"
                    android:textColor="#FF5252" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekThreshold" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:min="5" android:max="50"
                android:progress="20" android:progressTint="#FF5252" android:thumbTint="#FF5252" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Alert when red points exceed this % of total"
                android:textColor="@color/text_secondary" android:textSize="10sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#30363D" />

        <LinearLayout android:id="@+id/btnLicense"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="License"
                android:textColor="@color/text_primary" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SOON" android:textColor="@color/text_secondary" android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
